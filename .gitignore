# ============================================
# Music Manager - .gitignore
# ============================================

# CREDENCIALES PRIVADAS - NUNCA subir al repo
# (setup_spotify.bat crea este archivo en tu PC)
.env

# Cache de tokens de Spotify OAuth
data/.spotify_cache

# Entornos virtuales de Python
.venv/
venv/
env/

# Caché de Python
__pycache__/
*.pyc
*.pyo

# Salida de PyInstaller (compilación local)
build/
dist/
*.spec.bak

# Exportaciones CSV de playlists (datos personales)
data/Spotify/

# Archivos del sistema
Thumbs.db
Desktop.ini
*.lnk

# Documentación interna de desarrollo (se mantiene fuera del repo)
Doc informacion/
